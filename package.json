{
  "name": "lookman",
  "version": "2.0.0",
  "description": "A smarter console.log() for JavaScript. Debug values, detect changes, trace async operations, track mutations, and measure performance.",
  "keywords": [
    "debug",
    "debugging",
    "debugger",
    "logger",
    "logging",
    "log",
    "console",
    "console-log",
    "devtools",
    "developer-tools",
    "inspect",
    "trace",
    "watch",
    "proxy",
    "change-detection",
    "diff",
    "promise",
    "async",
    "mutation",
    "typescript",
    "zero-dependency"
  ],
  "homepage": "https://github.com/gurjotsaini53/lookman#readme",
  "bugs": {
    "url": "https://github.com/gurjotsaini53/lookman/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gurjotsaini53/lookman.git"
  },
  "license": "MIT",
  "author": "Gurjot Saini",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "node --import tsx benchmarks/run.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^3.2.4"
  }
}
